# ==============================================================
# eCare Django Backend - Environment Security Configuration
# ==============================================================

# Database Configuration (Neon PostgreSQL)
# For connection pooling on Neon, use the pooler connection string:
# Example: postgresql://[user]:[password]@[ep-xyz-pooler.region.aws.neon.tech]/[dbname]?sslmode=require
DATABASE_URL=

# Security & Debug Settings
# NEVER set DEBUG=True in production!
DEBUG=True
SECRET_KEY=ecare-insecure-change-this-to-a-64-character-random-secret-key-in-prod-2026
ALLOWED_HOSTS=127.0.0.1,localhost

# Custom Admin URL (Security by Obscurity - change from 'admin/' in prod)
DJANGO_ADMIN_URL=admin/

# SSL & HTTPS (Enable in Production)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# CORS Settings (Explicit origins allowed - do not use * with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting (Requests per minute)
RATE_LIMIT_ANON=60/minute
RATE_LIMIT_USER=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SUBMIT=15/minute

# Upload Spend & Size Cap (in bytes: 5MB = 5242880)
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

# Gmail SMTP Configuration (Use Gmail address + Google App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_google_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com
